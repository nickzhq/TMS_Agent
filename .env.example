# EstimatePrice Agent 环境变量模板
# 用法：复制为 .env 并填真实值；.env 已 gitignore，绝不入库（含密码/密钥）
# 警告：本文件（.env.example）会随 git 提交——只放占位符，绝不粘真实凭据！真实值请放 .env

# LLM（OpenAI 兼容端点：Qwen / DeepSeek / 自定义 vLLM/Ollama）
LLM_BASE_URL=https://your-llm-endpoint/v1
LLM_API_KEY=your-api-key
LLM_MODEL=your-model-name

# DB（pyodbc 直连，只读账户；凭据绝不入库）
# 方式①推荐：完整连接串——从 .qoder-cn/mcp.json 的 MSSQL_CONNECTION_STRING 复制整串到 .env
MSSQL_CONNECTION_STRING=Server=your-host,port;Database=your-db;User Id=your-user;Password=your-password;TrustServerCertificate=True;Encrypt=False;
# 方式②备用：分字段（MSSQL_CONNECTION_STRING 为空时用；host 要含端口 host,port）
MSSQL_HOST=your-host
MSSQL_DB=your-db
MSSQL_USER=your-readonly-user
MSSQL_PASSWORD=your-password

# 高德 MCP（地理编码 maps_geo）
AMAP_MAPS_API_KEY=your-amap-key

# WeKnora（知识库，默认不启用；启用时填服务地址）
WEKNORA_URL=http://localhost:8080
