# Environment variable template
# Usage: copy to .env and fill in real values; .env is gitignored and never committed (it holds secrets).
# Warning: this file (.env.example) IS committed — placeholders only, never real credentials! Real values belong in .env.

# LLM (any OpenAI-compatible endpoint)
LLM_BASE_URL=https://your-llm-endpoint/v1
LLM_API_KEY=your-api-key
LLM_MODEL=your-model-name

# Database (pyodbc direct connection, read-only account; credentials never committed)
# Option 1 (recommended): a full connection string
MSSQL_CONNECTION_STRING=Server=your-host,port;Database=your-db;User Id=your-user;Password=your-password;TrustServerCertificate=True;Encrypt=False;
# Option 2 (fallback): separate fields (used when MSSQL_CONNECTION_STRING is empty; host must include the port)
MSSQL_HOST=your-host
MSSQL_DB=your-db
MSSQL_USER=your-readonly-user
MSSQL_PASSWORD=your-password

# Map service MCP (geocoding)
AMAP_MAPS_API_KEY=your-map-key

# Knowledge base (disabled by default; set the service URL when enabled)
WEKNORA_URL=http://localhost:8080
