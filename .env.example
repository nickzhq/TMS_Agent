# Environment variable template
# Usage: copy to .env and fill in real values; .env is gitignored and never committed (it holds secrets).
# Warning: this file (.env.example) IS committed — placeholders only, never real credentials! Real values belong in .env.

# LLM (any OpenAI-compatible endpoint)
LLM_BASE_URL=https://your-llm-endpoint/v1
LLM_API_KEY=your-api-key
LLM_MODEL=your-model-name

# mem0 embedder — a SEPARATE OpenAI-compatible embeddings endpoint (the chat endpoint above may serve no /embeddings)
# Aliyun DashScope example: create a key in the Bailian/DashScope console (a chat-MaaS key will NOT work here -> 401)
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=your-embedding-api-key
EMBEDDING_MODEL=your-embedding-model-name

# Database (pyodbc direct connection, read-only account; credentials never committed)
# Option 1 (recommended): a full connection string
MSSQL_CONNECTION_STRING=Server=your-host,port;Database=your-db;User Id=your-user;Password=your-password;TrustServerCertificate=True;Encrypt=False;
# Option 2 (fallback): separate fields (used when MSSQL_CONNECTION_STRING is empty; host must include the port)
MSSQL_HOST=your-host
MSSQL_DB=your-db
MSSQL_USER=your-readonly-user
MSSQL_PASSWORD=your-password

# Map service MCP (geocoding)
AMAP_MAPS_API_KEY=your-map-key

# Knowledge base (disabled by default; set the service URL when enabled)
WEKNORA_URL=http://localhost:8080

# Chainlit auth (JWT secret) — REQUIRED once an auth callback is enabled. The native thread-history
# sidebar (/project/threads) needs an authenticated user, so the app uses a mock login. Generate a
# secret with `chainlit create-secret`; put the real value in .env only (never here).
CHAINLIT_AUTH_SECRET=your-chainlit-jwt-secret

# Backend API + real auth (P8 front/back split). Non-secret defaults (host/port/urls) live in
# config.yaml; only the backend JWT secret MUST come from here. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_JWT_SECRET=your-backend-jwt-secret

# Persistence backend (P8 batch-2). sqlite = files under data/ (default, zero setup, dev/tests);
# postgres = multi-user production. To switch: set PERSISTENCE_PROVIDER=postgres, fill POSTGRES_DSN,
# then `docker compose up -d` (starts Postgres + Qdrant server with data persisted under ./data/).
PERSISTENCE_PROVIDER=sqlite
POSTGRES_DSN=postgresql://estimate:your-pg-password@localhost:5432/estimate
# Postgres container init (docker-compose reads these); keep in sync with POSTGRES_DSN above
POSTGRES_DB=estimate
POSTGRES_USER=estimate
POSTGRES_PASSWORD=your-pg-password
# mem0 Qdrant mode: local (embedded, default) or server (Docker, multi-process). Set server after `docker compose up -d`.
QDRANT_MODE=local

# Bill Agent: output root of the generated invoice set (user/shipper/period three levels).
# Empty -> a default folder on the user's desktop (double-click to open the result directly).
# Example: BILL_OUTPUT_ROOT=C:\Users\your-name\Desktop\<billing-output-folder>
BILL_OUTPUT_ROOT=
# Bill Agent: user folder under the output root. Empty -> "ai_gen" (CLI placeholder);
# the web entry point passes the logged-in user name instead.
BILL_OUTPUT_USER=

# Bill Agent: billing ledger backend. Every run is recorded here, and the previous period's
# ledger rows provide the baseline for part-3 deductions. postgres = shared DB (default;
# needs `docker compose up -d`, reuses POSTGRES_DSN above when BILL_LEDGER_DSN is empty);
# sqlite = local file (zero setup, used only by the sqlite backend).
# Both share one interface, so switching is config-only.
BILL_LEDGER_DB=data/bill_ledger.db
BILL_LEDGER_PROVIDER=postgres
BILL_LEDGER_DSN=
# Bill Agent: postgres schema that holds the ledger tables (created on first use).
# Keeps them isolated from the app tables (checkpoints / sessions / users) in the same database.
BILL_LEDGER_SCHEMA=bill
