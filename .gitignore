# Qoder local MCP config (contains DB connection info, never commit)
.qoder-cn/mcp.json

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Environment files (real credentials, never commit)
.env
.env.local
.env.*.local

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Python
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/

# Chainlit runtime artifacts (generated by `chainlit run`; local-only config + welcome page)
.chainlit/
chainlit.md
# note: data/chainlit.log (and everything under data/) is already ignored by the data/* rule below

# --- Local-only content: docs / data / SQL / manuals managed separately, NOT uploaded ---
# Only empty directories (via .gitkeep placeholders) are shown in the repo.

# docs/: local-only documents
docs/*
!docs/.gitkeep

# data/: geocoding cache and other runtime data
data/*
!data/.gitkeep

# tests/: local-only, depend on untracked SQL / DB
tests/*
!tests/.gitkeep

# agents/: local-only manuals + SQL; keep the empty sub-folders
agents/*/*
!agents/*/.gitkeep

# AGENTS.md: local-only AI collaboration notes
AGENTS.md

# any SQL asset
*.sql

# src/agents/: local-only sub-agent implementations; keep empty folder
src/agents/*
!src/agents/.gitkeep

# src/graph/: LangGraph orchestration; keep empty folder
src/graph/*
!src/graph/.gitkeep
