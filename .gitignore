# Qoder local MCP config (contains DB connection info, never commit)
.qoder-cn/mcp.json

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Environment files (real credentials, never commit)
.env
.env.local
.env.*.local

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local-only notes (dev progress / resume material / temp logs, not uploaded)
progress.md
record.md
tmp_res.md

# Python
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/

# Chainlit runtime artifacts (generated by `chainlit run`): the translation cache is local-only.
# config.toml IS tracked on purpose - UI name / avatar / feature switches are project config.
# (The welcome copy itself lives in src/web/chainlit_app.py, which is tracked.)
.chainlit/*
!.chainlit/config.toml
chainlit.md
# note: data/chainlit.log (and everything under data/) is already ignored by the data/* rule below

# Avatars: keep the README (documents the ASCII-id rule), never the logo image itself -
# it is a company asset. A missing file falls back to Chainlit's favicon (still 200, no error).
public/avatars/*
!public/avatars/README.md

# --- Company assets: business docs / data / SQL / manuals are managed separately, NOT uploaded ---
# Only empty directories (via .gitkeep placeholders) are shown in the repo.

# docs/: business documents (DB schema, product spec) -- sensitive, never uploaded
docs/*
!docs/.gitkeep

# data/: geocoding cache and other runtime data
data/*
!data/.gitkeep

# tests/: contain business parameters and depend on untracked SQL / DB
tests/*
!tests/.gitkeep

# agents/: business manuals (SKILL.md / README.md) + SQL; keep the 5 empty sub-folders
agents/*/*
!agents/*/.gitkeep

# AGENTS.md: root AI constitution (business rules + table names)
AGENTS.md

# any SQL asset
*.sql

# src/agents/: business sub-agent node implementations (P3+); keep empty folder
src/agents/*
!src/agents/.gitkeep

# src/graph/: LangGraph orchestration (business flow, P4+); keep empty folder
src/graph/*
!src/graph/.gitkeep

# src/bill/: billing business package (real table names / business rules / shipper data, never uploaded)
src/bill/*
!src/bill/.gitkeep

# --- Billing outputs (company property): sample inputs / generated workbooks / voucher sets -- never uploaded ---
*.xls
*.xlsx
账单_tmp/
账单_AI生成/
# legacy per-shipper period folders (e.g. <shipper>-2026-10/) holding voucher PDFs; kept generic on purpose (no real shipper names)
*-[0-9][0-9][0-9][0-9]-[0-9][0-9]/

src/profit/*

# 利润分析产物与业务规则（含全公司营收/成本/货主，不入库）
dis.md
profile_per_month.md
司机奖金_规则.txt
